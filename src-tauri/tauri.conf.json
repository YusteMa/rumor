{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rumor",
  "version": "0.1.0-beta.1",
  "identifier": "io.github.yustema.rumor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Rumor contributors",
    "copyright": "Copyright (c) 2026 Rumor contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Real-time pink, brown and white noise for the Windows tray",
    "windows": {
      "wix": {
        "version": "0.1.0.1",
        "language": "en-US"
      },
      "nsis": {
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
